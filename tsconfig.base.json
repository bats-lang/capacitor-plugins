{
  "compilerOptions": {
    "declaration": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2017",
    "lib": ["dom", "es2017"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "pretty": true,
    "sourceMap": true,
    "inlineSources": true
  }
}
